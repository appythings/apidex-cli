{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apidex.dev/schema/apidex-manifest.schema.json",
  "title": "Apidex spec-repo manifest",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "products": {
      "type": "array",
      "items": {"$ref": "#/$defs/product"}
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "openapi": {"type": "string"},
          "overlays": {"$ref": "#/$defs/overlays"},
          "products": {
            "type": "array",
            "items": {"$ref": "#/$defs/product"}
          }
        },
        "not": {"required": ["docs"]}
      }
    },
    "teams": {"type": "array"},
    "backendTeams": {"type": "array"}
  },
  "$defs": {
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["locale", "path"],
        "properties": {
          "locale": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "docs": {
      "type": "array",
      "contains": {"$ref": "#/$defs/overviewEntry"},
      "minContains": 0,
      "maxContains": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/docEntry"},
          {"$ref": "#/$defs/overviewEntry"}
        ]
      }
    },
    "docEntry": {
      "type": "object",
      "required": ["markdown"],
      "properties": {
        "type": {"const": "doc"},
        "markdown": {"type": "string"},
        "title": {"type": "string"},
        "slug": {
          "type": "string",
          "not": {"enum": ["spec", "overview"]}
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["locale", "markdown"],
            "properties": {
              "locale": {
                "type": "string",
                "not": {"const": "en-GB"}
              },
              "markdown": {"type": "string"},
              "title": {"type": "string"}
            }
          }
        }
      }
    },
    "overviewEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "overview"}
      }
    },
    "product": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Gateway product id/name, not catalog displayName"
        },
        "openapi": {"type": "string"},
        "inheritSpec": {"type": "boolean"},
        "portalType": {
          "type": "string",
          "enum": ["api", "mcp"],
          "default": "api"
        },
        "permissionGroup": {"type": "string"},
        "backendTeam": {},
        "overlays": {"$ref": "#/$defs/overlays"},
        "docs": {"$ref": "#/$defs/docs"}
      }
    }
  }
}
